rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function researcher() {
      return request.auth != null
        && ((exists(/databases/$(database)/documents/studyResearchers/$(request.auth.uid))
          && get(/databases/$(database)/documents/studyResearchers/$(request.auth.uid)).data.enabled == true)
          || ('email' in request.auth.token && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/studyResearcherEmails/$(request.auth.token.email))
            && get(/databases/$(database)/documents/studyResearcherEmails/$(request.auth.token.email)).data.enabled == true));
    }
    match /studyResearchers/{uid} {
      allow read: if owns(uid);
    }
    match /studyResearcherEmails/{email} {
      allow read: if request.auth != null && 'email' in request.auth.token
        && request.auth.token.email_verified == true && request.auth.token.email == email;
    }
    match /{path=**}/sessions/{sessionId} {
      allow read: if researcher();
    }
    match /studyParticipants/{uid} {
      allow read: if owns(uid) || researcher();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['latestResearchId', 'latestSessionId', 'lastSavedAt'])
        && request.resource.data.latestSessionId is string
        && exists(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(request.resource.data.latestSessionId))
        && request.resource.data.latestResearchId == get(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(request.resource.data.latestSessionId)).data.researchId
        && request.resource.data.lastSavedAt == request.time;
    }
    match /studyParticipants/{uid}/sessions/{sessionId} {
      allow read: if owns(uid) || researcher();
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['researchId', 'studyOrder', 'schemaVersion', 'createdAt'])
        && request.resource.data.researchId is string
        && request.resource.data.researchId.size() > 0
        && request.resource.data.researchId.size() <= 100
        && (request.resource.data.studyOrder == null || request.resource.data.studyOrder in ['lecture-first', 'geoscratch-first'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studyOrder'])
        && (resource.data.studyOrder == null || resource.data.studyOrder == request.resource.data.studyOrder)
        && request.resource.data.studyOrder in ['lecture-first', 'geoscratch-first'];
      match /records/{stageId} {
        allow read: if owns(uid) || researcher();
        allow create, update: if owns(uid)
          && exists(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(sessionId))
          && stageId in ['demographics', 'lecture-exercise-1', 'lecture-exercise-2',
            'condition-1', 'geoscratch-trial', 'geoscratch-exercise-1',
            'geoscratch-exercise-2', 'condition-2', 'post-study']
          && request.resource.data.keys().hasOnly(['stageId', 'data', 'savedAt'])
          && request.resource.data.stageId == stageId
          && request.resource.data.data is map
          && request.resource.data.savedAt == request.time;
      }
      match /recovery/{documentId} {
        allow read: if owns(uid) || researcher();
        allow create, update: if owns(uid) && documentId == 'current'
          && exists(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(sessionId))
          && request.resource.data.keys().hasOnly(['snapshot', 'savedAt'])
          && request.resource.data.snapshot is map
          && request.resource.data.savedAt == request.time;
      }
      match /interactions/{eventId} {
        allow read: if owns(uid) || researcher();
        allow create, update: if owns(uid)
          && exists(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(sessionId))
          && request.resource.data.keys().hasOnly(['eventId', 'researchId', 'exerciseId', 'type', 'occurredAt', 'streamId', 'sequence', 'sessionId', 'dataJson', 'payloadChunks', 'savedAt'])
          && request.resource.data.eventId == eventId
          && request.resource.data.sessionId == sessionId
          && request.resource.data.researchId == get(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(sessionId)).data.researchId
          && request.resource.data.exerciseId in ['create-complex-object', 'cube-point-pivot-rotation', 'point-plane-distance']
          && request.resource.data.type is string && request.resource.data.occurredAt is string
          && request.resource.data.streamId is string && request.resource.data.sequence is int
          && (('dataJson' in request.resource.data && request.resource.data.dataJson is string)
            || ('payloadChunks' in request.resource.data && request.resource.data.payloadChunks is int && request.resource.data.payloadChunks > 0))
          && request.resource.data.savedAt == request.time;
      }
      match /interactionPayloads/{partId} {
        allow read: if owns(uid) || researcher();
        allow create, update: if owns(uid)
          && exists(/databases/$(database)/documents/studyParticipants/$(uid)/sessions/$(sessionId))
          && request.resource.data.keys().hasOnly(['eventId', 'index', 'text'])
          && request.resource.data.eventId is string && request.resource.data.index is int
          && request.resource.data.index >= 0 && request.resource.data.text is string
          && request.resource.data.text.size() <= 260000;
      }
    }
  }
}
